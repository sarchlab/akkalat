{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Python: Current File",
			"type": "python",
			"request": "launch",
			"program": "${file}",
			"console": "integratedTerminal",
			"justMyCode": true
		},
		{
			"name": "FIR-32CUPerGPU_withCache",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/32CUPerGPU_withCache",
			"args": [
				"-timing",
				"-magic-memory-copy",
				"-benchmark=fir",
				"-report-all"
			],
			// "envFile": "${workspaceFolder}/../.env",
		},
		{
			"name": "FIR-model1",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/64CUPerGPU_withCache",
			"args": [
				"-timing",
				"-magic-memory-copy",
				"-benchmark=fastwalshtransform",
				"-report-all",
				"-analyzer-Name=test",
				"-analyzer-period=1e-7",
			],
			// "envFile": "${workspaceFolder}/../.env",
		},
		{
			"name": "FIR-model6 atax",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/model6_48_Small_GPU",
			"args": [
				"-timing",
				"-magic-memory-copy",
				"-benchmark=atax",
				"-report-all"
			],
			// "envFile": "${workspaceFolder}/../.env",
		},
		{
			"name": "PageRank",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/model1",
			"args": [
				"-timing",
				"-magic-memory-copy",
				"-benchmark=pagerank",
				"-report-all",
			]
		},
		{
			"name": "simpleMesh Debuger BitonicSort",
			"type": "go",
			"request": "launch",
			"mode": "auto",
			"program": "${workspaceFolder}/simpleMesh",
			"args": [
				"-timing",
				"-magic-memory-copy",
				"-benchmark=bitonicsort",
				"-report-all",
				"-bandwidth=960"
				// "-num-memory-banks=16"
			],
			// "envFile": "${workspaceFolder}/../.env",
		}
	]
}